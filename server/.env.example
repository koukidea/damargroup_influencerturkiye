# ---- Sunucu ----
PORT=4000
# Reverse proxy arkasında çalışırken 127.0.0.1 bırakın (port dışarı açılmaz).
HOST=127.0.0.1
NODE_ENV=production

# ---- Güvenlik ----
# MUTLAKA değiştirin. Üretmek için:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# ---- Reverse proxy / hız sınırı ----
# Zincirdeki güvenilen proxy sayısı. Yerel geliştirmede ve aaPanel'de tek Nginx
# varsa 1 bırakın. Canlıdaki influencerturkiye.com Cloudflare arkasında olduğu
# için zincir "Cloudflare -> Nginx" şeklinde iki katman: orada 2 olmalı.
# Doğrulama: /api/health çıktısındaki "ip" alanı kendi genel IP'nizi göstermeli.
# Cloudflare IP'si (104.x / 172.6x-7x.x / 188.114.x) görüyorsanız değer düşüktür.
TRUST_PROXY=1

# Acil durum kapısı. Proxy gerçek istemci IP'sini iletmiyorsa tüm ziyaretçiler
# tek IP gibi sayılır ve hız sınırı herkesi engeller. Böyle bir durumda geçici
# olarak true yapın. Doğrulama: https://alan-adiniz.com/api/health çıktısındaki
# "ip" alanı kendi genel IP'nizi göstermelidir, 127.0.0.1 değil.
RATE_LIMIT_DISABLED=false

# ---- Görsel yükleme ----
# Panelden yüklenen görsellerin yazılacağı klasör. Boş bırakılırsa server/uploads
# kullanılır. Build (dist/) dışında olduğu için yeni sürüm yüklemek dosyaları
# silmez; yine de yedeğe bu klasörü de dahil edin.
UPLOAD_DIR=

# ---- SEO ----
# Sitemap ve robots.txt içindeki mutlak adresler bundan üretilir.
# Boş bırakılırsa isteğin geldiği alan adı kullanılır (reverse proxy arkasında
# genelde doğru sonucu verir). Farklı bir alan adı kullanacaksanız doldurun.
SITE_URL=https://influencerturkiye.com

# ---- CORS ----
# Site ile API aynı alan adındaysa (/api reverse proxy) bu ayar kullanılmaz,
# yine de doğru adresi yazın. Birden fazla adres virgülle ayrılır.
CORS_ORIGIN=https://influencerturkiye.com

# ---- E-posta (form bildirimleri) ----
# SMTP_HOST boş bırakılırsa mail gönderimi kapalıdır: başvurular yine
# veritabanına yazılır, yalnızca bildirim maili çıkmaz.
SMTP_HOST=
SMTP_PORT=465
# 465 → örtük TLS, 587 → STARTTLS. Boş bırakılırsa porta göre karar verilir.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Gönderen adresi. Boş bırakılırsa SMTP_USER kullanılır. SPF/DKIM'in geçerli
# olması için alan adınıza ait bir kutu olmalı.
MAIL_FROM=no-reply@influencerturkiye.com

# Form türüne göre bildirimlerin düşeceği kutular.
MAIL_TO_BRAND=customer@influencerturkiye.com
MAIL_TO_INFLUENCER=influencer@influencerturkiye.com
MAIL_TO_CONTACT=hello@influencerturkiye.com

# ---- Veritabanı ----
# MySQL/MariaDB için aşağıdaki satırların başındaki # işaretini kaldırın.
# Veritabanını utf8mb4 ile oluşturun:
#   CREATE DATABASE db_adi CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# DB_CLIENT=mysql2
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# DB_CLIENT boş bırakılırsa SQLite kullanılır (sadece yerel geliştirme için).
SQLITE_FILE=./data/dev.sqlite3
